{
  "name": "@learncroc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The local learncroc server (Bun + Hono), bound to 127.0.0.1.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts --dev",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@learncroc/ai": "workspace:*",
    "@learncroc/core": "workspace:*",
    "@learncroc/widgets": "workspace:*",
    "dompurify": "^3.4.17",
    "happy-dom": "^21.0.3",
    "hono": "^4.13.13",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/semver": "^7.8.0"
  }
}
