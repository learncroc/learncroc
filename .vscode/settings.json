{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml" },
  "typescript.tsdk": "node_modules/typescript/lib",
  "yaml.schemas": {
    "./schemas/pack.schema.json": [
      "packs/*/pack.yaml",
      "packs/_pocket/*/pack.yaml",
      "packages/core/fixtures/*/pack.yaml",
      "templates/pack/pack.yaml"
    ],
    "./schemas/map.schema.json": [
      "packs/*/map.yaml",
      "packs/_pocket/*/map.yaml",
      "packages/core/fixtures/*/map.yaml",
      "templates/pack/map.yaml"
    ],
    "./schemas/node.schema.json": [
      "packs/*/nodes/*.yaml",
      "packs/_pocket/*/nodes/*.yaml",
      "packages/core/fixtures/*/nodes/*.yaml",
      "templates/pack/nodes/*.yaml"
    ],
    "./schemas/boss.schema.json": [
      "packs/*/bosses/*.yaml",
      "packages/core/fixtures/*/bosses/*.yaml",
      "templates/pack/bosses/*.yaml"
    ],
    "./schemas/toy.schema.json": ["packs/*/toy.yaml"],
    "./schemas/lock.schema.json": [
      "packs/*/pack.lock.yaml",
      "packs/_pocket/*/pack.lock.yaml",
      "packages/core/fixtures/*/pack.lock.yaml"
    ]
  }
}
